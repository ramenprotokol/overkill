{
  "name": "overkill",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Opus 5.5 overengineers your chores as chain-reaction machines, then has to prove they work in a physics sim.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config tests/e2e/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p tests/e2e",
    "build": "vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "design": "tsx src/design/cli.ts",
    "spike": "tsx src/spike/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@dimforge/rapier2d-deterministic-compat": "0.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@types/node": "22.20.4",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
