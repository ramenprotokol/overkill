# Secrets — never commit
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.local
*.env

# Cloudflare / wrangler
.wrangler/
.mf/

# Node / Python / build
node_modules/
dist/
build/
__pycache__/
.venv/
.pytest_cache/

# OS
.DS_Store

# Spike run output (raw runs stay local; curated summaries get committed)
results/

# Design harness scratch (lock and temp files while a call runs)
machines/*.lock
machines/*.tmp

# Agent state, browser-test output and local Cloudflare state — never commit
.claude/
.codex/
.specstory/
.playwright-mcp/
.playwright-cli/
test-results/
playwright-report/
